{
  "name": "@blueshift-gg/solana-ml-dsa",
  "version": "0.1.0",
  "description": "TurboSHAKE ML-DSA-44 for solana-ml-dsa, built from Noble.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshift-gg/solana-ml-dsa",
    "directory": "packages/ml-dsa"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./turboshake": {
      "types": "./dist/turboshake.d.ts",
      "default": "./dist/turboshake.js"
    }
  },
  "files": ["dist/turboshake.js", "dist/turboshake.d.ts", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20.19.0" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
